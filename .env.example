# Live site address, used for canonical URLs, sitemap, Open Graph and schema.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend API key for the contact form.
RESEND_API_KEY=

# Optional sender on a domain verified in Resend. Defaults to contact@primedeskgroup.com.
# CONTACT_FROM_EMAIL=website@primedeskgroup.com

# Public Google Calendar appointment schedule URL. An empty value uses the demo event link.
NEXT_PUBLIC_BOOKING_URL=
